<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wastra Account | Login or Signup</title>
    <link rel="stylesheet" href="style.css">
    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon">
    <link rel="icon" href="./asset/favicon.ico" type="image/x-icon">
</head>
<body class="logup">
    <div class="login-signup-container">
        <div class="form-box">
            <a href="index.php" class="back-home">← Kembali ke Home</a>
            <div class="button-box">
                <div id="btn"></div>
                <button type="button" class="toggle-btn" onclick="login()">Log In</button>
                <button type="button" class="toggle-btn" onclick="signup()">Sign Up</button>
            </div>
            <form id="login" class="input-group">
                <input type="text" name="username" class="input-field" placeholder="Username" required>
                <input type="password" name="password" class="input-field" placeholder="Password" required>
                <button type="submit" class="submit-btn">Log In</button>
            </form>


            <form id="signup" class="input-group">
                <input type="text" name="username" class="input-field" placeholder="Username" required>
                <input type="email" name="email" class="input-field" placeholder="Email" required>
                <input type="password" name="password" class="input-field" placeholder="Password" required>
                <button type="submit" class="submit-btn">Sign Up</button>
            </form>



        </div>
        <script>
        var loginForm = document.getElementById("login");
        var signupForm = document.getElementById("signup");
        var btn = document.getElementById("btn");

        function signup(){
            loginForm.style.left = "-100%";
            signupForm.style.left = "0";
            btn.style.left = "130px";
        }

        function login(){
            loginForm.style.left = "0";
            signupForm.style.left = "100%";
            btn.style.left = "0";
        }
        </script>

        <div id="toast" class="toast"></div>

        <script>
            const toast = document.getElementById("toast");

            function showToast(message, type = "success") {
                toast.textContent = message;
                toast.className = `toast show ${type}`;
                setTimeout(() => {
                    toast.className = "toast";
                }, 3000);
            }

            // LOGIN
            document.getElementById("login").addEventListener("submit", function(e){
                e.preventDefault();

                const formData = new FormData(this);

                fetch("login.php", {
                    method: "POST",
                    body: formData
                })
                .then(res => res.json())
                .then(data => {
                    if(data.status === "success"){
                        localStorage.setItem("wastra_login", "true"); // SIMPAN STATUS LOGIN
                        showToast(data.message, "success");

                        setTimeout(() => {
                            // CEK APAKAH USER ADMIN
                            if(parseInt(data.id) === 2){  // pakai parseInt supaya tipe pasti number
                                window.location.href = "admin_payments.php";
                            } else {
                                window.location.href = "produk";
                            }
                        }, 1500);

                    } else {
                        showToast(data.message, "error");
                    }
                })
                .catch(() => {
                    showToast("Terjadi kesalahan server.", "error");
                });
            });



            // SIGNUP
            document.getElementById("signup").addEventListener("submit", function(e){
                e.preventDefault();

                const formData = new FormData(this);

                fetch("signup.php", {
                    method: "POST",
                    body: formData
                })
                .then(res => res.json())
                .then(data => {
                    if(data.status === "success"){
                        showToast(data.message, "success");
                    } else {
                        showToast(data.message, "error");
                    }
                })
                .catch(() => {
                    showToast("Terjadi kesalahan server.", "error");
                });
            });


            </script>




</body>



<div id="loading-screen">
  <div class="loader-content">
    <div class="logo">WASTRA NUSANTARA</div>
    <div class="tagline">Warisan Tradisi Anak Bangsa</div>
  </div>
</div>

<script>
  window.addEventListener("load", function () {
    const loader = document.getElementById("loading-screen");
    loader.classList.add("hidden");
  });
</script>
</html>