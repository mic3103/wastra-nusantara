<script>
const sheetURL = "https://docs.google.com/spreadsheets/d/e/2PACX-1vTO8E7MpBtGpohVMcjLgQWoMh4RsnrELZp3eUqn990jXPuKMOeMVngDbFVE1Px9mtTBOGWDOaqmUos4/pub?gid=502053556&single=true&output=tsv";

fetch(sheetURL)
  .then(res => res.text())
  .then(data => {
    const rows = data.split("\n").slice(1); // skip header
    const container = document.getElementById("productContainer");

    rows.forEach(row => {
      if(row.trim() === "") return;

      const cols = row.split("\t");

      const nama = cols[1];
      const harga = cols[2];
      const deskripsi = cols[3];
      const fotoLink = cols[4];
      const kategori = cols[5];

      const imgURL = convertDriveLink(fotoLink);

      const card = document.createElement("div");
      card.className = "product-card";
      card.innerHTML = `
        <img src="${imgURL}" alt="${nama}">
        <h3>${nama}</h3>
        <p>${deskripsi}</p>
        <h3>Rp ${Number(harga).toLocaleString("id-ID")}</h3>
        <p>Kategori: ${kategori}</p>
        <div class="login-bli" onclick="addToCart('${nama}', ${harga})">
            <h5>Tambah Ke Keranjang</h5>
        </div>
      `;

      container.appendChild(card);
    });
  })
  .catch(err => console.error("Gagal ambil data:", err));

function convertDriveLink(url) {
  if (!url) return "";
  
  let fileId = "";
  
  // Format 1: /file/d/{FILE_ID}/preview (format lu)
  if (url.includes('/file/d/')) {
    const match = url.match(/\/file\/d\/([a-zA-Z0-9_-]+)/);
    if (match) {
      fileId = match[1];
    }
  }
  // Format 2: /d/{FILE_ID}/ (format lama)
  else if (url.includes('/d/')) {
    const match = url.match(/\/d\/([a-zA-Z0-9_-]+)/);
    if (match) {
      fileId = match[1];
    }
  }
  // Format 3: ?id={FILE_ID}
  else if (url.includes('id=')) {
    const match = url.match(/[?&]id=([a-zA-Z0-9_-]+)/);
    if (match) {
      fileId = match[1];
    }
  }
  
  if (fileId) {
    return `https://drive.google.com/thumbnail?id=${fileId}&sz=w500`;
  }
  
  return url;
}


function searchProduct() {
  const input = document.getElementById("searchInput").value.toLowerCase();
  const cards = document.getElementsByClassName("product-card");

  for (let i = 0; i < cards.length; i++) {
    const productName = cards[i].getElementsByTagName("h3")[0].innerText.toLowerCase();
    const productDesc = cards[i].getElementsByTagName("p")[0].innerText.toLowerCase();
    const productCategory = cards[i].getElementsByTagName("p")[1].innerText.toLowerCase();

    if (productName.includes(input) || productDesc.includes(input) || productCategory.includes(input)) {
      cards[i].style.display = ""; 
    } else {
      cards[i].style.display = "none"; 
    }
  }
}

function filterProduct(kategori, btn) {
    // Ubah status tombol aktif
    const buttons = document.getElementsByClassName("filter-btn");
    for (let b of buttons) {
        b.classList.remove("active");
    }
    btn.classList.add("active");

    // Filter produk
    const cards = document.getElementsByClassName("product-card");
    const searchInput = document.getElementById("searchInput").value.toLowerCase();

    for (let i = 0; i < cards.length; i++) {
        // Ambil teks kategori dari p[1] (sesuai struktur innerHTML yang kamu buat)
        const productCategory = cards[i].getElementsByTagName("p")[1].innerText.toUpperCase();
        const productName = cards[i].getElementsByTagName("h3")[0].innerText.toLowerCase();

        const matchKategori = (kategori === 'SEMUA' || productCategory.includes(kategori));
        const matchSearch = productName.includes(searchInput);

        if (matchKategori && matchSearch) {
            cards[i].style.display = "";
        } else {
            cards[i].style.display = "none";
        }
    }
}

let cart = JSON.parse(localStorage.getItem("wastra_cart")) || [];

// 1. Fungsi Tambah ke Keranjang
function addToCart(nama, harga) {
    if(!isUserLoggedIn()){
        alert("Silakan login terlebih dahulu untuk menambahkan ke keranjang.");
        window.location.href = "loginsignup";
        return;
    }

    const item = { nama, harga };
    cart.push(item);
    updateCart();
    alert(nama + " ditambahkan ke keranjang!");
}


// 2. Fungsi Update Tampilan & Hitung Total
function updateCart() {
    localStorage.setItem("wastra_cart", JSON.stringify(cart));
    document.getElementById("cartCount").innerText = cart.length;
    
    const container = document.getElementById("cartItems");
    const totalDisplay = document.getElementById("cartTotalPrice");
    container.innerHTML = "";
    
    let total = 0;
    cart.forEach((item, index) => {
        total += item.harga;
        container.innerHTML += `
            <div class="cart-item">
                <div>
                    <h4>${item.nama}</h4>
                    <p>Rp ${item.harga.toLocaleString("id-ID")}</p>
                </div>
                <button onclick="removeFromCart(${index})" style="background:none; border:none; color:red; cursor:pointer;">Hapus</button>
            </div>
        `;
    });
    
    totalDisplay.innerText = "Rp " + total.toLocaleString("id-ID");
}

function removeFromCart(index) {
    cart.splice(index, 1);
    updateCart();
}

function toggleCart() {
    const modal = document.getElementById("cartModal");
    modal.style.display = modal.style.display === "block" ? "none" : "block";
    updateCart();
}

function toggleOrders(){
    const modal = document.getElementById("orderOverlay");
    modal.style.display = modal.style.display === "block" ? "none" : "block";
    loadOrders();
}

// Ambil data pesanan user
function loadOrders(){
    const orderContainer = document.getElementById("orderItems");
    orderContainer.innerHTML = "";

    // Contoh sementara: ambil dari localStorage (nanti bisa ganti ke PHP + database)
    const orders = JSON.parse(localStorage.getItem("wastra_orders")) || [];

    if(orders.length === 0){
        orderContainer.innerHTML = "<p>Belum ada pesanan.</p>";
        return;
    }

    orders.forEach((order, index) => {
        orderContainer.innerHTML += `
            <div class="cart-item">
                <div>
                    <h4>Pesanan #${index+1}</h4>
                    <p>Total: Rp ${order.total.toLocaleString("id-ID")}</p>
                    <p>Status: ${order.status}</p>
                    <p>Alamat: ${order.alamat}</p>
                </div>
            </div>
        `;
    });
}

document.getElementById("orderBtn").addEventListener("click", function(e){
    e.preventDefault();
    toggleOrders();
});


// 3. Fungsi Pesan via WhatsApp
function checkout() {
    if (cart.length === 0) return alert("Keranjang kosong!");

    // Simpan data checkout
    localStorage.setItem("wastra_checkout", JSON.stringify(cart));

    // Pindah ke halaman pembayaran
    window.location.href = "pembayaran.php";
}



// Jalankan update saat halaman pertama kali dibuka
updateCart();
</script>


